# Worker base image. Contains OS/runtime/toolchain and third-party parser deps,
# but not the local application source tree.
# syntax=docker/dockerfile:1.7
FROM python:3.13-slim-bookworm AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PATH="/app/.venv/bin:$PATH"

# build-essential/g++/gcc are needed here because some parsers-full transitive
# deps have no prebuilt wheel for this image. They are not copied into the
# worker-base stage below, which only needs the resulting /app/.venv.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends \
      curl ca-certificates \
      build-essential g++ gcc \
      libgl1 libglib2.0-0

COPY --from=ghcr.io/astral-sh/uv:0.7.12 /uv /usr/local/bin/uv

WORKDIR /app

COPY pyproject.toml README.md uv.lock ./

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project --extra api --extra cli --extra postgres \
      --extra redis --extra minio --extra qdrant --extra neo4j \
      --extra llm \
      --extra observability --extra parsers-full \
    || uv sync --frozen --no-dev --no-install-project --extra api --extra cli --extra postgres \
      --extra redis --extra minio --extra qdrant --extra neo4j \
      --extra llm \
      --extra observability --extra parsers-docling --extra parsers-ocr --extra parsers \
    || uv sync --frozen --no-dev --no-install-project --extra api --extra cli --extra postgres \
      --extra redis --extra minio --extra qdrant --extra neo4j \
      --extra llm \
      --extra observability --extra parsers


FROM python:3.13-slim-bookworm AS worker-base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PATH="/app/.venv/bin:$PATH"

# g++ must stay in the runtime image: docling's layout stage uses
# torch._inductor (torch.compile), which JIT-compiles C++ at run time, not
# just at `uv sync` time. Without it every docling parse fails with
# "InvalidCxxCompiler: No working C++ compiler found ... cxx: (None, 'g++')".
# gcc/build-essential are still build-only and stay out of this stage.
#
# fonts-noto-cjk/fontconfig: pdfium (used to rasterize PDF pages before
# GPT-vision transcription) falls back to its own built-in glyphs for Latin
# text but has no CJK glyphs of its own -- without a system CJK font, any
# Japanese/Chinese/Korean text that isn't a pre-rendered raster image renders
# as blank/missing, so a vision model literally cannot read it no matter how
# good the prompt or render resolution is. Confirmed empirically: this image
# had zero font files besides two bundled Latin-only Python package assets.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends \
      curl ca-certificates \
      g++ \
      libgl1 libglib2.0-0 \
      fonts-noto-cjk fontconfig \
    && groupadd --system --gid 1000 app \
    && useradd --system --uid 1000 --gid app --create-home --home-dir /app app

COPY --from=ghcr.io/astral-sh/uv:0.7.12 /uv /usr/local/bin/uv

WORKDIR /app

COPY pyproject.toml README.md uv.lock ./
COPY --from=builder /app/.venv /app/.venv
