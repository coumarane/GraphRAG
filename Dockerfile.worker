# Worker image (parser-capable profile). Builds the worker target from Dockerfile.
# syntax=docker/dockerfile:1.7
FROM python:3.13-slim-bookworm AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PATH="/app/.venv/bin:$PATH"

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends \
      curl ca-certificates \
      libgl1 libglib2.0-0 \
    && groupadd --system --gid 1000 app \
    && useradd --system --uid 1000 --gid app --create-home --home-dir /app app

COPY --from=ghcr.io/astral-sh/uv:0.7.12 /uv /usr/local/bin/uv

WORKDIR /app

# Install third-party dependencies from the lockfile first, without building
# the local project, so application-code edits (which change on nearly every
# build) don't invalidate this layer and force a full reinstall of every
# dependency each time. --no-install-project defers the local package build
# to the fast final sync below, once src/ is present. openai/langchain/azure
# are already covered by uv.lock (llm extra + core deps), so no separate
# unlocked `uv pip install` is needed.
COPY pyproject.toml README.md uv.lock ./

# Prefer the full parser fleet (Docling, PaddleOCR, MinerU, Marker). Fall back
# to layout-only extras if a heavy SDK cannot resolve on this platform.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project --extra api --extra cli --extra postgres \
      --extra redis --extra minio --extra qdrant --extra neo4j \
      --extra llm \
      --extra observability --extra parsers-full \
    || uv sync --frozen --no-dev --no-install-project --extra api --extra cli --extra postgres \
      --extra redis --extra minio --extra qdrant --extra neo4j \
      --extra llm \
      --extra observability --extra parsers-docling --extra parsers-ocr --extra parsers \
    || uv sync --frozen --no-dev --no-install-project --extra api --extra cli --extra postgres \
      --extra redis --extra minio --extra qdrant --extra neo4j \
      --extra llm \
      --extra observability --extra parsers

COPY src ./src
COPY alembic ./alembic
COPY alembic.ini ./
COPY config ./config

# Install the local project itself now that src/ is present. All
# dependencies are already installed above, so this only builds and links
# the enterprise_rag package and is fast even without cache hits.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --extra api --extra cli --extra postgres \
      --extra redis --extra minio --extra qdrant --extra neo4j \
      --extra llm \
      --extra observability --extra parsers-full \
    || uv sync --frozen --no-dev --extra api --extra cli --extra postgres \
      --extra redis --extra minio --extra qdrant --extra neo4j \
      --extra llm \
      --extra observability --extra parsers-docling --extra parsers-ocr --extra parsers \
    || uv sync --frozen --no-dev --extra api --extra cli --extra postgres \
      --extra redis --extra minio --extra qdrant --extra neo4j \
      --extra llm \
      --extra observability --extra parsers

USER app

CMD ["enterprise-rag", "worker", "--poll-interval", "1.0"]
