# Application
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO
APP_CONFIG_DIR=config
APP_SERVICE_NAME=enterprise-rag

# Object / vector / graph backends for local API
# memory (default) or minio / qdrant / neo4j
OBJECT_STORE_BACKEND=minio
VECTOR_STORE_BACKEND=qdrant
GRAPH_STORE_BACKEND=neo4j
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=enterprise_rag
POSTGRES_USER=enterprise_rag
POSTGRES_PASSWORD=change-me
POSTGRES_SSL_MODE=prefer

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=enterprise-rag

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-change-me

# OpenAI
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1
OPENAI_VISION_MODEL=gpt-4.1
OPENAI_EXTRACTION_MODEL=gpt-4.1
OPENAI_SUMMARIZATION_MODEL=gpt-4.1
OPENAI_QUERY_MODEL=gpt-4.1
OPENAI_ANSWER_MODEL=gpt-4.1
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Models
MODELS_IMPLEMENTATION=langchain
MODELS_PROVIDER=openai

# Security limits
MAX_UPLOAD_BYTES=104857600
MAX_PAGES=2000

# Testing
RUN_LIVE_OPENAI_TESTS=false
